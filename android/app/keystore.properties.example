# Copy this file to keystore.properties and fill in real values.
# Never commit keystore.properties or your .keystore file to git.
#
# storeFile: path to the keystore file relative to android/app/
# Example: release.keystore (in android/app/) or ../release.keystore (in android/)
storeFile=release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=alpha-vlogs-release
keyPassword=YOUR_KEY_PASSWORD
