# Resolve react_native_pods.rb with node to allow for hoisting
def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
else
  # Static frameworks — required by Firebase / RN Firebase on iOS
  use_frameworks! :linkage => :static
end

target 'JackMarvelsApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Permissions handler setup for react-native-permissions
  # ⬇️ uncomment wanted permissions
  setup_permissions([
    'PhotoLibrary',
  ])

  target 'JackMarvelsAppTests' do
    inherit! :complete
    # Pods for testing
  end

  # Fix build scripts when the project path contains spaces (e.g. "React Native")
  def fix_react_native_script_phases_for_spaces(installer)
    installer.pods_project.targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        script = phase.shell_script
        next if script.nil? || !script.include?('WITH_ENVIRONMENT')

        script = script.gsub(
          'export RCT_SCRIPT_RN_DIR=$RCT_SCRIPT_POD_INSTALLATION_ROOT/../node_modules/react-native',
          'export RCT_SCRIPT_RN_DIR="$RCT_SCRIPT_POD_INSTALLATION_ROOT/../node_modules/react-native"'
        )
        script = script.gsub(
          'export RCT_SCRIPT_APP_PATH=$RCT_SCRIPT_POD_INSTALLATION_ROOT/..',
          'export RCT_SCRIPT_APP_PATH="$RCT_SCRIPT_POD_INSTALLATION_ROOT/.."'
        )
        script = script.gsub(
          'export RCT_SCRIPT_OUTPUT_DIR=$RCT_SCRIPT_POD_INSTALLATION_ROOT',
          'export RCT_SCRIPT_OUTPUT_DIR="$RCT_SCRIPT_POD_INSTALLATION_ROOT"'
        )
        script = script.gsub(
          '/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"',
          '"$WITH_ENVIRONMENT" "$SCRIPT_PHASES_SCRIPT"'
        )
        phase.shell_script = script
      end
    end
    installer.pods_project.save
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    fix_react_native_script_phases_for_spaces(installer)

    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
          config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
          config.build_settings['PROVISIONING_PROFILE'] = ''
          config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
        end
      end
    end

    # Fix for Razorpay Swift protocol linking and other build issues
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Pod targets must not use app provisioning profiles (CI manual signing)
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['PROVISIONING_PROFILE'] = ''
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''

        # Xcode 26+ workaround: fmt 11.x consteval fails with newer Apple Clang
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end

        # Set minimum iOS deployment target for all pods
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        
        # Ensure Swift interoperability is enabled
        config.build_settings['SWIFT_VERSION'] = '5.0' if config.build_settings['SWIFT_VERSION'].nil?
        
        # Always embed Swift standard libraries for Swift-based pods.
        # Skip resource/privacy bundles: setting this on a *.bundle makes Xcode's
        # archive CopySwiftLibs phase look for a nonexistent executable inside the
        # bundle (e.g. "Promises_Privacy.bundle/Promises_Privacy"), failing the archive.
        is_resource_bundle = target.respond_to?(:product_type) &&
          target.product_type == 'com.apple.product-type.bundle'
        if !is_resource_bundle &&
           (target.name.include?('Lottie') || target.name.include?('lottie') || target.name.include?('Swift'))
          config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'
        end
        
        # Fix for boost_privacy.bundle - ensure it's built as a dependency
        if target.name == 'boost-boost_privacy'
          config.build_settings['SKIP_INSTALL'] = 'NO'
        end
      end
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        next unless target.name == 'JackMarvelsApp'

        target.build_configurations.each do |config|
          config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = '$(inherited)'
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end
end
